  m_Name: SSO_Log_MushroomWarning
  m_EditorClassIdentifier: 
  Header: 'WARNING: HAZARDOUS MUSHROOMS'
  Body: "Keep your distance from spheric purple mushrooms. \r\n\r\nThis species releases
    spores at any sign of movement. These spores dissolve any organic lifeform that
    comes into contact, accelerating their propagation.\r\n\r\nShould you observe
    any sign of mushroom activity, please contact the Architects' Maintenance Branch.
    A Multipurpose Automaton will be sent your way to dispose of them."
  IsDiscovered: 1
