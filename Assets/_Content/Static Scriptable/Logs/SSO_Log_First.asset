  m_Script: {fileID: 11500000, guid: eec19ee5ee046b143bf10d7c394ce807, type: 3}
  m_Name: SSO_Log_First
  m_EditorClassIdentifier: 
  Header: To all subsequent Saviors !
  Body: "If you\u2019re reading this, then I\u2019ve most likely failed to reach
    the bottom. (Though with my skills I was probably soooooo close\u2026)\r\n\r\nThanks
    to the Tower\u2019s divine powers, you have the knowledge of our previous attempts.
    As such, our best hope of reaching the bottom and bringing salvation to our people\u2026
    is you. (\u2190 No pressure !)\r\n\r\nRajanii"
  IsDiscovered: 1
