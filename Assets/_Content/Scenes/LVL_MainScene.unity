        type: 2}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: m_logHeader
      value: Jour 49 du mois 3
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: m_logBody.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: 'm_logBody.Array.data[0]'
      value: "Petite fille: \u201COhalala j\u2019ai pas envie qu\u2019il finisse
        le dernier niveau, maman dit qu\u2019on vera bientot plus le soleil. Gribouille
        va pas aimer \xE7a\u2026\u201D"
      objectReference: {fileID: 0}
