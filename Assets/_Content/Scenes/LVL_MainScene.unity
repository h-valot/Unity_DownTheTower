    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: m_body
      value: "The Portable Fabricator is the Architect\u2019s latest solution for
        efficient navigation of the Tower. \n\nBy streamlining the production of
        ropes and torches, custodians are now able to access secluded structures
        while retaining close to perfect visibility, without the need to resupply
        at equipment centers."
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: m_header
      value: 'Custodian''s Handbook: Portable Fabricator'
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: m_ssoLog
