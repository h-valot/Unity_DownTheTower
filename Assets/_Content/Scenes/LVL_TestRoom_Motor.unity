      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: m_logHeader
      value: Fan Non-Fiction
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: _logBody.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: m_logBody.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: '_logBody.Array.data[0]'
      value: 'Keep your distance from the Bloating Mushrooms. '
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: '_logBody.Array.data[1]'
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: '_logBody.Array.data[2]'
      value: This species releases spores at any sign of movement. These spores dissolve
        any organic lifeform that comes into contact, turning it into sustinence
        for the mushrooms and accelerating their propagation.
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: '_logBody.Array.data[3]'
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: '_logBody.Array.data[4]'
      value: "Should you observe any sign of mushroom activity, please contact the
        Architect\u2019s Maintenance Branch. A multipurpose automaton will be sent
        your way to dispose of the mushrooms."
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: 'm_logBody.Array.data[0]'
      value: Colin gasps as he starts to feel something growing against his lascivious
        dumpy. The hands of an unknown person are sliding against his hips. Excitement
        starts to swell inside him.
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: 'm_logBody.Array.data[1]'
      value: 'So long has he been waiting for something like this. The mysterious
        person''s hot breath tickles his ears, sending a shiver down his spine: it''s
        Hugo.'
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: 'm_logBody.Array.data[2]'
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: 'm_logBody.Array.data[3]'
      value: "\"Pardon j'esp\xE8re que ma Hot Wheels\xAE 1969 Pink Rear-Loading Beach
        Bomb qui est dans ma poche ne t'as pas fait mal\""
      objectReference: {fileID: 0}
    - target: {fileID: 6303369563507938974, guid: 888ff82ccbb828942b5fe6cc9718388d,
        type: 3}
      propertyPath: 'm_logBody.Array.data[4]'
      value: "\"Eh \xE7a rentre dans ton p\xE9tou tu pense ?\""
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 888ff82ccbb828942b5fe6cc9718388d, type: 3}
